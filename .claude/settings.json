{
  "$schema": "https://claude.ai/schemas/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run test)",
      "Bash(npm run test:ci)",
      "Bash(npm run test:e2e)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest)",
      "Bash(npx playwright test)",
      "Bash(npx vite build)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(git add)",
      "Bash(git commit)",
      "Bash(git branch)",
      "Bash(git checkout)",
      "Bash(git switch)",
      "Bash(git merge)",
      "Bash(git stash)",
      "Bash(git pull)",
      "Bash(ls)",
      "Bash(cat)",
      "Bash(find)",
      "Bash(tree)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(git push --force)",
      "Bash(git reset --hard)",
      "Bash(npm publish)"
    ]
  },
  "env": {
    "VITE_API_BASE_URL": "http://localhost:3000/api"
  }
}
